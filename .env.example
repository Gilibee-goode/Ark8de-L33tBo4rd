# -----------------------------------------------------------------
# .env.example — Environment variable template
# -----------------------------------------------------------------
# Copy this file to .env and fill in the values for your local dev.
#
#   cp .env.example .env
#
# The .env file is gitignored and must NEVER be committed.
# This example file IS committed — it documents what variables the
# application expects without exposing real secrets.
# -----------------------------------------------------------------

# DATABASE_URL is the PostgreSQL connection string.
# Format: postgres://<user>:<password>@<host>:<port>/<database>?<options>
# sslmode=disable is fine for local development; enable it in production.
DATABASE_URL=postgres://ark8de:ark8de_dev@localhost:5432/ark8de?sslmode=disable

# PORT is the TCP port the HTTP server listens on.
# 8080 is the conventional non-privileged port for Go web servers.
PORT=8080

# JWT_SECRET is the private key used to sign and verify JWT tokens.
# IMPORTANT: Change this to a long random string in production.
# Generate a good one with: openssl rand -base64 32
# This value is for local development ONLY — never commit a real secret.
JWT_SECRET=local-dev-secret-change-me-in-production
